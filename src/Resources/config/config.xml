<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd"><card><title>Messaging backend</title>
<input-field type="bool"><name>telnyxEnabled</name><label>Enable Telnyx</label><defaultValue>false</defaultValue></input-field>
<input-field type="text"><name>telnyxFrom</name><label>Telnyx registered sender</label></input-field>
<input-field type="text"><name>telnyxProfile</name><label>Telnyx Messaging Profile</label></input-field>
<input-field type="bool"><name>plivoEnabled</name><label>Enable Plivo</label><defaultValue>false</defaultValue></input-field>
<input-field type="text"><name>plivoFrom</name><label>Plivo registered sender</label></input-field>
<input-field type="text"><name>defaultProvider</name><label>Primary provider: telnyx or plivo</label><defaultValue>telnyx</defaultValue></input-field>
<input-field type="text"><name>backupProvider</name><label>Backup provider: telnyx or plivo</label><defaultValue>plivo</defaultValue></input-field>
<input-field type="bool"><name>autoFailover</name><label>Enable safe failover</label><defaultValue>false</defaultValue></input-field>
<input-field type="int"><name>maxAttempts</name><label>Maximum attempts (429 only)</label><defaultValue>3</defaultValue></input-field>
<input-field type="int"><name>monthlySegments</name><label>Monthly segment quota</label><defaultValue>1000</defaultValue></input-field>
<input-field type="int"><name>perMinute</name><label>Attempts per minute</label><defaultValue>30</defaultValue></input-field>
<input-field type="int"><name>maxSegments</name><label>Maximum segments per SMS</label><defaultValue>6</defaultValue></input-field>
<input-field type="text"><name>senderIdentity</name><label>Marketing sender business identity (required)</label></input-field><input-field type="int"><name>timeoutSeconds</name><label>Provider HTTP timeout seconds (1–30)</label><defaultValue>10</defaultValue></input-field></card></config>
